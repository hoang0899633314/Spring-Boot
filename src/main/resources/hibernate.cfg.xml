<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">

<hibernate-configuration>
    <session-factory>
        <!-- ==========================================
             CẤU HÌNH KẾT NỐI DATABASE
             ========================================== -->

        <!-- Driver MySQL -->
        <property name="hibernate.connection.driver_class">com.mysql.cj.jdbc.Driver</property>

        <!-- URL Database -->
        <property name="hibernate.connection.url">
            jdbc:mysql://localhost:3306/employee_management?useSSL=false&amp;serverTimezone=UTC&amp;allowPublicKeyRetrieval=true
        </property>

        <!-- Username MySQL -->
        <property name="hibernate.connection.username">root</property>

        <!-- Password MySQL - ⚠️ SỬA DÒNG NÀY -->
        <property name="hibernate.connection.password">123456</property>

        <!-- ==========================================
             CẤU HÌNH CONNECTION POOL CƠ BẢN
             ========================================== -->

        <!-- Số lượng connection tối đa -->
        <property name="hibernate.connection.pool_size">10</property>

        <!-- ==========================================
             CẤU HÌNH SQL VÀ DIALECT
             ========================================== -->

        <!-- SQL Dialect cho MySQL 8.x -->
        <property name="hibernate.dialect">org.hibernate.dialect.MySQL8Dialect</property>

        <!-- Hiển thị SQL ra console -->
        <property name="hibernate.show_sql">true</property>

        <!-- Format SQL cho dễ đọc -->
        <property name="hibernate.format_sql">true</property>

        <!-- Hiển thị comment trong SQL -->
        <property name="hibernate.use_sql_comments">true</property>

        <!-- ==========================================
             CẤU HÌNH SCHEMA
             ========================================== -->

        <!-- Tự động cập nhật schema -->
        <property name="hibernate.hbm2ddl.auto">update</property>

        <!-- ==========================================
             CẤU HÌNH SESSION
             ========================================== -->

        <!-- Session context cho thread -->
        <property name="hibernate.current_session_context_class">thread</property>

        <!-- Tắt contextual LOB creation -->
        <property name="hibernate.jdbc.lob.non_contextual_creation">true</property>

        <!-- ==========================================
             ENTITY MAPPINGS
             ========================================== -->

        <!-- Map Entity Employee -->
        <mapping class="com.example.JasonShaw.employee_backup.model.Employee"/>

        <!-- Map Entity Department -->
        <mapping class="com.example.JasonShaw.employee_backup.model.Department"/>

    </session-factory>
</hibernate-configuration>